@startuml deployment
!pragma layout smetana
skinparam defaultFontName Tahoma
skinparam shadowing false
skinparam node {
  BackgroundColor #EEF4FB
  BorderColor #2E5C8A
}

title PrintFlow — Deployment Diagram

node "User Device" as Device {
  artifact "Web Browser" as Browser
}

node "Developer Machine" as Dev {
  artifact "Source code\n(Git)" as Src
  artifact "docker compose\n(app + postgres:15)" as Compose
}

cloud "GitHub" as GitHub {
  artifact "Repository\nbbthecat/Print_shop_final" as Repo
  node "GitHub Actions" as Actions {
    artifact "CI: mvn clean verify\n+ test report" as CI
    artifact "CD: trigger Render\ndeploy hook (main)" as CD
  }
}

cloud "Render (Singapore)" as Render {
  node "Web Service: printflow\n(Free, Docker)" as WebService {
    node "Docker Container\neclipse-temurin:17-jre" as Container {
      artifact "printflow.jar\n(Spring Boot 3, Tomcat :$PORT)" as Jar
    }
  }
}

cloud "Neon (ap-southeast-1)" as Neon {
  database "PostgreSQL\nneondb" as Pg
}

Browser --> Jar : HTTPS\nprintflow-ogm4.onrender.com
Src --> Repo : git push
Repo --> CI : push / pull request
CI --> CD : main เท่านั้น
CD --> WebService : POST deploy hook
Repo --> WebService : auto-deploy\n(branch develop)
Jar --> Pg : JDBC over TLS\n(sslmode=require)

note right of WebService
  ENV: DB_URL, DB_USER, DB_PASSWORD,
  SPRING_PROFILES_ACTIVE=prod,
  ADMIN_USERNAME / EMAIL / PASSWORD
  (secrets อยู่บน Render เท่านั้น)
end note

@enduml
